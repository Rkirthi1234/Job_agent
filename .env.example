APP_NAME=AI Job Agent
ENVIRONMENT=development

DATABASE_URL=sqlite:///./ai_job_agent.db

UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# LLM_PROVIDER is informational for now (llm_service.py talks to any
# OpenAI-compatible endpoint) but is kept so future providers
# (Azure OpenAI, Microsoft Foundry, OpenRouter, ...) are a one-line change.
LLM_PROVIDER=ollama
# Local Ollama: LLM_MODEL=llama3.1, LLM_BASE_URL=http://localhost:11434/v1, OPENAI_API_KEY= (empty)
# Ollama Cloud: LLM_MODEL=gpt-oss:20b, LLM_BASE_URL=https://ollama.com/v1, OPENAI_API_KEY=<your ollama.com API key>
LLM_MODEL=gpt-oss:20b
LLM_BASE_URL=https://ollama.com/v1
OPENAI_API_KEY=
LLM_TIMEOUT_SECONDS=60

# Set to false if your local model/provider does not support
# OpenAI's {"type": "json_object"} response_format.
LLM_JSON_RESPONSE_FORMAT=true

# Jooble job source (Phase 4B) -- register for a free key at
# https://jooble.org/api/about (each Jooble country domain needs its own
# key; jooble.org covers the US, in.jooble.org would cover India, etc.).
# Leave empty until you have a real key -- the 'jooble' job source will
# raise a clear configuration error rather than silently failing.
# Never commit a real key here.
JOOBLE_API_KEY=
JOOBLE_BASE_URL=https://jooble.org/api

# Real application adapter (Phase 5C) -- app/integrations/application_sources/real.py
# This is the normal production application path (true by default). Set to
# false only to force MockApplicationSource for local manual testing --
# automated tests already pin this independently in tests/conftest.py.
REAL_APPLICATION_ENABLED=true
REAL_APPLICATION_TIMEOUT_SECONDS=15.0
# One entry per specific, inspected destination that has a real, documented
# submission API (e.g. a Greenhouse job board's public application API, or
# a Lever posting's public API). Comma-separated "domain=submit_url" pairs.
# Empty by default -- no destination is pre-approved for real submission out
# of the box; an unconfigured destination is always reported "unsupported",
# never faked as submitted. Never commit real credentials here -- if a
# destination's API needs one, add it as its own variable and read it
# through app/config.py, the same way JOOBLE_API_KEY is handled.
# Example: REAL_APPLICATION_SUPPORTED_DESTINATIONS=boards.greenhouse.io=https://boards-api.greenhouse.io/v1/boards/example/jobs
REAL_APPLICATION_SUPPORTED_DESTINATIONS=

# ATS browser-automation adapters (Phase 5D) --
# app/integrations/application_sources/greenhouse.py / lever.py. Used
# automatically (no extra flag) whenever REAL_APPLICATION_ENABLED=true
# AND the resolved application destination is recognized as a
# Greenhouse or Lever posting -- see app/integrations/application_sources/ats_detector.py.
# Requires: pip install playwright && playwright install chromium
PLAYWRIGHT_HEADLESS=true
# Local directory (relative to the project root) where pre-submit/
# post-submit screenshots are saved for every ATS submission attempt.
# Never served publicly -- a debugging/audit trail only.
APPLICATION_ARTIFACTS_DIR=application_artifacts

# OPTIONAL -- Wellfound session reuse (app/integrations/application_sources/wellfound.py).
# Wellfound's own native Apply flow requires the candidate to be signed in.
# By default this app never types a Wellfound username/password (see the
# explicit, opt-in WELLFOUND_AUTO_LOGIN section at the bottom of this block).
# If you have manually signed in to YOUR OWN Wellfound account in a Chromium
# profile (outside this app), point this at that profile's user-data directory and
# WellfoundApplicationSource will reuse that already-authenticated session
# instead of opening a fresh, logged-out one. Leave empty (default) for the
# unchanged behavior: a fresh context every run, reporting blocker="login"
# as soon as Wellfound's sign-in wall is detected.
#
# FIRST RUN with a profile set: if the profile is not signed in yet, the
# adapter clicks Wellfound's own "Log in with your account" link and waits
# (polling, never a blind sleep) for YOU to finish signing in by hand in the
# browser window it opened. The session is saved in the profile, so every
# later run is already signed in: no login click, no wait. If you do not
# finish within the window below, the run stops safely with
# status=manual_review, blocker=login_not_completed (nothing is submitted).
WELLFOUND_USER_DATA_DIR=
# Seconds to wait for you to finish the manual login (default 120; 0 = don't
# wait). Only ever used on a run that is not already signed in, and only when
# WELLFOUND_AUTO_LOGIN=false.
WELLFOUND_LOGIN_WAIT_SECONDS=120

# OPTIONAL, EXPLICIT OPT-IN -- Wellfound automatic login.
# WELLFOUND_AUTO_LOGIN=false (the default) means the agent NEVER types a
# username/password; the manual-login flow above is unchanged.
# Set it to true only if you want the agent to sign in to YOUR OWN Wellfound
# account with the email/password below when its session is not already
# authenticated. Clicking "Log in" is never treated as proof of login: the
# agent re-opens the application page and verifies the signed-in state.
# If WELLFOUND_AUTO_LOGIN=true but either value is empty, the run stops safely
# with status=manual_review, blocker=credentials_missing. A wrong password,
# CAPTCHA or verification-code prompt stops with blocker=login_failed (the
# agent never solves or bypasses a CAPTCHA/2FA challenge).
# The password is never logged, returned by the API, saved to the database or
# written to the audit trail. Put the real values ONLY in your local .env
# (which is git-ignored) -- never in this file.
WELLFOUND_AUTO_LOGIN=false
WELLFOUND_EMAIL=
WELLFOUND_PASSWORD=

